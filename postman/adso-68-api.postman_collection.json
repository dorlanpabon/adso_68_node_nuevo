				{
					"name": "Pagar (admin)",
					"request": {
						"method": "PUT",
						"header": [],
						"url": {
							"raw": "{{base_url}}/facturas/{{factura_id}}/pagar",
							"host": ["{{base_url}}"],
							"path": ["facturas", "{{factura_id}}", "pagar"]
						}
					}
				}
			]
		},
		{
			"name": "5. Inventario",
			"item": [
				{
					"name": "Stock actual",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{base_url}}/inventario?minimo=10",
							"host": ["{{base_url}}"],
							"path": ["inventario"],
							"query": [
								{ "key": "minimo", "value": "10", "description": "Muestra solo productos con stock menor o igual" },
