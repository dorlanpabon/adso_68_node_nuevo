							]
						}
					}
				},
				{
					"name": "Registrar entrada / salida / ajuste (admin)",
					"request": {
						"method": "POST",
						"header": [],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"producto_id\": {{producto_id}},\n  \"tipo\": \"entrada\",\n  \"cantidad\": 10,\n  \"motivo\": \"Compra del proveedor\"\n}",
							"options": { "raw": { "language": "json" } }
						},
						"url": {
							"raw": "{{base_url}}/inventario/movimientos",
							"host": ["{{base_url}}"],
							"path": ["inventario", "movimientos"]
						}
					}
				}
			]
		}
	]
}
